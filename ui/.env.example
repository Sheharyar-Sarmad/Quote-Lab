# Get Your API key from https://www.console.groq.com and create an API and copy the API key here. This is required to run the app locally.
NEXT_PUBLIC_GROQ_API_KEY=your_groq_api_key_here
# Paste Your Render Deployed API Base URL here. Otherwise for local development, you can use my pasted URL below. This is required to run the app locally.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:10000
